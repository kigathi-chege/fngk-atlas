{
  "name": "fngk-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0 --port 4173\"",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "start:host": "bash scripts/start-host.sh",
    "build:fngk-head": "bash scripts/build-fngk-head.sh",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config desktop/src-tauri/tauri.conf.json",
    "desktop:bundle": "npm run desktop:build",
    "test": "npm run test:legacy && vitest run",
    "test:legacy": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:live": "bash scripts/live-acceptance.sh",
    "interpreter:validate": "tsx scripts/atlas-interpreter.ts validate",
    "interpreter:test": "tsx scripts/atlas-interpreter.ts test",
    "interpreter:explain": "tsx scripts/atlas-interpreter.ts explain",
    "check:web": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@lucide/svelte": "^1.45.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cytoscape": "^3.33.1",
    "dockview": "^8.1.0",
    "fastify": "^5.6.1",
    "svelte": "^5.39.6",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.5",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
