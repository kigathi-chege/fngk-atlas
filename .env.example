# Atlas server environment (server process only; never expose to the browser, never commit real values).

# Explanation-only analysis through Nipate Intelligence (POST /api/intelligence/exec/analyze).
# A service-client key with scope agents:execute, created in the Intelligence console (Service clients).
ATLAS_INTELLIGENCE_KEY=
# Default: https://intelligence.nipate.africa
ATLAS_INTELLIGENCE_URL=
# Workspace id analysis is attributed and billed to. Default: atlas
ATLAS_INTELLIGENCE_WORKSPACE=

# Agent Chat conversations still run through Calculator.
ATLAS_CALCULATOR_URL=
ATLAS_CALCULATOR_TOKEN=
